# Copy to .env (or .env.local) and fill in as needed

# Temporal
# These map directly to Settings fields in src/config.py
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agent-queue

# OpenAI-compatible config
# If using Azure OpenAI, either set OPENAI_BASE_URL and OPENAI_API_KEY directly,
# or set AZURE_OPENAI_* and the app will project them for compatibility.
# Example (direct):
OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1/
OPENAI_API_KEY=<your-api-key>
OPENAI_MODEL=<your-model>

# Optional: OTEL tracing (OTLP HTTP endpoint)
# OTEL_ENDPOINT=http://localhost:4318/v1/traces

# API server (used by Makefile api target)
HOST=0.0.0.0
PORT=8000
