# Copy to .env and fill in as needed
# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=deep-agent-task-queue

# LLM providers (optional depending on tools)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Azure OpenAI (optional)
# If AZURE_OPENAI_ENDPOINT is set, the app will use AzureChatOpenAI
# Required:
#   AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
#   AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Optional:
#   AZURE_OPENAI_API_KEY= # if not using keyless/AAD
#   AZURE_OPENAI_API_VERSION=2024-05-01-preview
# For AAD/keyless, you can also set standard Azure credentials (e.g., via az login)
#   AZURE_CLIENT_ID=
#   AZURE_TENANT_ID=
#   AZURE_CLIENT_SECRET=

# API server
HOST=0.0.0.0
PORT=8000
